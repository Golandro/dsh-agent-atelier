{
  "name": "dsh-plugin-agents-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Agents Manager scaffold: an installable Cordis bundle whose empty agent registry ticket 01 fills.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "bundled",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:static": "node scripts/check.mjs",
    "check": "node scripts/check.mjs && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
