{
  "name": "dsh-plugin-agents-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Agents Manager: an installable Cordis bundle that discovers and serves agent.md definitions as the agentRegistry service.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/dsh/host/core.d.ts",
      "default": "./lib/dsh/host/core.js"
    },
    "./providers/fs": {
      "types": "./lib/dsh/host/providers.d.ts",
      "default": "./lib/dsh/host/providers.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "bundled",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:static": "node scripts/check.mjs",
    "check": "node scripts/check.mjs && pnpm run typecheck && pnpm test"
  },
  "engines": {
    "node": ">=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "js-yaml": "^5.5.0",
    "zod": "^4.6.7"
  }
}
