{
  "name": "dsh-agent-atelier",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Atelier: an installable Cordis bundle that discovers and serves agent.md definitions as the agentRegistry service.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/dsh/host/core.d.ts",
      "default": "./lib/dsh/host/core.js"
    },
    "./providers/fs": {
      "types": "./lib/dsh/host/providers.d.ts",
      "default": "./lib/dsh/host/providers.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "bundled",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs && node scripts/build-chunks.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:static": "node scripts/check.mjs",
    "check": "node scripts/check.mjs && pnpm run typecheck && pnpm test",
    "proto": "vite --config prototype/settings-ui/vite.config.ts --host 127.0.0.1 --port 4188",
    "proto:build": "vite build --config prototype/settings-ui/vite.config.ts",
    "proto:preview": "vite preview --config prototype/settings-ui/vite.config.ts --host 127.0.0.1 --port 4188"
  },
  "engines": {
    "node": ">=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@tanstack/react-table": "^9.3.1",
    "codemirror": "^6.0.2",
    "js-yaml": "^5.5.0",
    "zod": "^4.6.7"
  }
}
